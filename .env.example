# Copy this file to .env and fill in the values. .env is private and git-ignored.
#
# This configures LOCAL development against CLOUD Firestore (not the emulator).
# Do NOT set FIRESTORE_EMULATOR_HOST here — its mere presence switches the SDK to the
# emulator. Automated tests and resettable rehearsals use the emulator separately
# (see docs/DEVELOPMENT.md). Keep your service-account key OUTSIDE the repo.

# --- Cloud Firestore connection ---
GOOGLE_CLOUD_PROJECT=campus-asset-concierge
# Absolute path to your service-account key JSON (never commit the key itself).
GOOGLE_APPLICATION_CREDENTIALS="C:/path/to/service-account-key.json"

# --- Account passwords (used for browser login and REST Basic) ---
LOCAL_BORROWER_A_PASSWORD=change-me
LOCAL_BORROWER_B_PASSWORD=change-me
LOCAL_STAFF_PASSWORD=change-me
# Leave empty to disable operator reset and test-clock actions in this profile.
LOCAL_OPERATOR_PASSWORD=

# --- Passwordless local demo login (loopback only; disable before hosting) ---
# With DEV_LOGIN=1, open /dev-login and pick borrower_a, borrower_b, or staff.
DEV_LOGIN=1

# --- Borrower booking assistant (Gemini API) ---
# Free API key from Google AI Studio: https://aistudio.google.com/apikey
# Without it, the assistant chat shows a friendly fallback and the rest of the app still works.
GEMINI_API_KEY=
# Optional: override the model id (default: gemini-flash-latest). Confirm the exact id in AI Studio.
#GEMINI_MODEL=gemini-flash-latest
